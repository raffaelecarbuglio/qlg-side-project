# Source a personal copy after building sl2cfoam-next; use absolute shared paths.
export SL2CFOAM_ROOT=/path/to/sl2cfoam-next
export SL2CFOAM_LIBRARY="$SL2CFOAM_ROOT/lib/libsl2cfoam.so"
export SL2CFOAM_TABLES="$SL2CFOAM_ROOT/data_sl2cfoam"
# Also expose non-system shared-library dependencies if your HPC modules do not.
# export LD_LIBRARY_PATH=/path/to/local/lib:${LD_LIBRARY_PATH:-}
